FROM node:22-bookworm-slim
WORKDIR /workspace
ENV AGENT_APP_ID=market-research
ENV AGENT_PROVIDER=codex
ENV RUNNER_CLI_BIN_DIRS=/opt/agent-cli/bin
COPY skills /opt/app-skills
RUN mkdir -p /workspace /opt/agent-cli/bin \
  && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl fd-find git jq poppler-utils python-is-python3 python3 python3-pip ripgrep \
  && rm -rf /var/lib/apt/lists/* \
  && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
  && python3 -m pip install --no-cache-dir --break-system-packages reportlab pdfplumber pypdf \
  && python3 -m pip install --no-cache-dir --break-system-packages tavily-cli \
  && npm install -g @openai/codex@latest
CMD ["bash", "-lc", "codex --version && sleep infinity"]
