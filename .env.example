MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_DATABASE=codex_skilled
MYSQL_USER=codex
MYSQL_PASSWORD=codex-password

# Docker Compose derives DATABASE_URL from MYSQL_* values for backend containers.
# Use this only for host-side Prisma commands.
DATABASE_URL=mysql://codex:codex-password@localhost:3306/codex_skilled
REDIS_HOST=redis
REDIS_PORT=6379
WORKSPACE_ROOT=/workspace-data
RUNNER_URL=http://runner:4317
HOST_RUNNER_URL=http://host.docker.internal:4317
RUNNER_SHARED_SECRET=change-me
# Linux compose mounts this host path into /opt/agent-cli/bin inside the runner container.
RUNNER_CLI_HOST_BIN_DIR=/usr/local/agent-cli/bin
RUNNER_CLI_BIN_DIRS=/opt/agent-cli/bin
JWT_AUDIENCE=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

NG_APP_API_URL=http://localhost:3000
NG_APP_FIREBASE_API_KEY=
NG_APP_FIREBASE_AUTH_DOMAIN=
NG_APP_FIREBASE_PROJECT_ID=
NG_APP_FIREBASE_APP_ID=
